eckable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[47,1163][1033,2400]"><node index="0" text="金丝熊，也叫叙利亚仓鼠，是体型较大的宠物仓鼠，毛色常见金黄、奶油、黑白等。它们有以下特点：&#10;&#10;独居：成年后应一鼠一笼，合笼可能打架受伤。&#10;夜行性：白天通常睡觉，傍晚和夜间活动较多。&#10;喜欢挖掘和储藏食物：需要较深的无香、低粉尘垫料。&#10;需要较大空间：准备合适尺寸的跑轮、躲避屋、磨牙用品和清洁饮水。&#10;饮食要均衡：以专业主粮为主，少量喂蔬菜和零食，不能只喂瓜子；禁止巧克力、洋葱、蒜、酒精等食物。&#10;不宜水洗：一般会自行清洁，脏污或生病时应咨询异宠兽医。&#10;&#10;刚接回家时应让它安静适应几天，不要白天强行叫醒或突然抓取。若出现持续不吃不喝、呼吸异常、严重腹泻、脱毛或行动异常，应尽快就医。" resource-id="" class="android.widget.TextView" package="ai.cyrene.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[47,1163][1033,2400]" /></node></node><node index="3" text="" resource-id="" class="android.widget.EditText" package="ai.cyrene.mobile" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="true" password="false" selected="false" bounds="[42,1738][1038,1969]"><node index="0" text="给 Agent 下达任务" resource-id="" class="android.widget.TextView" package="ai.cyrene.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[84,1801][440,1864]" /></node><node NAF="true" index="4" text="" resource-id="" class="android.widget.CheckBox" package="ai.cyrene.mobile" content-desc="" checkable="true" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[43,1970][169,2096]" /><node index="5" text="Plan 模式" resource-id="" class="android.widget.TextView" package="ai.cyrene.mobile" content-desc="" checkable="false" checked